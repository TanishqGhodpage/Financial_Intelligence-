# ============================================================
# Financial Intelligence Platform — Environment Variables
# ============================================================
# Copy this file to .env and fill in values.
# Never commit .env to version control.

# App
DEBUG=false

# SQLite (default for dev) or PostgreSQL
# Format: sqlite+aiosqlite:///./finplatform.db
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=sqlite+aiosqlite:///./finplatform.db
DATABASE_ECHO=false

# Local file storage
STORAGE_BASE_PATH=./storage

# OpenRouter AI Provider (Phase 3)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,poolside/laguna-m.1:free
